{
  "name": "LEXIA — Agents juridiques",
  "short_name": "LEXIA",
  "description": "Équipe d'agents juridiques IA spécialisés en droit OHADA, UEMOA, CIMA et ivoirien. Données chiffrées sur l'appareil.",
  "id": "./",
  "start_url": "./#/chat",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#12100e",
  "theme_color": "#12100e",
  "lang": "fr",
  "dir": "ltr",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Assistant IA", "url": "./#/chat/new", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Automatisation juridique", "url": "./#/auto", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Dossiers", "url": "./#/dossiers", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "files", "accept": ["application/pdf", ".pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", ".docx", "text/plain", "image/*"] }] }
  }
}
